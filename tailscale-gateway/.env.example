# tailscale-gateway takes its settings from tailscale-gateway.env (sops-encrypted, committed; edit with "make edit").
# This file only documents the variables. Do not create a plaintext .env with real values in this public repository.
DOH_UPSTREAM=https://<location-subdomain>.cloudflare-gateway.com/dns-query   # Cloudflare Zero Trust > Gateway > DNS locations > Default Location
HOST_PUBLIC_IPV4=<this VPS public IPv4>                                          # blocked as a destination for gateway clients
TS_AUTHKEY=                                                                      # optional; empty = interactive one-time login with "make login"
